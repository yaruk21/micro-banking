# Django core
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=your-ec2-public-ip,your-domain.com
CSRF_TRUSTED_ORIGINS=http://your-ec2-public-ip,https://your-domain.com
TIME_ZONE=Europe/Kyiv

# Local/test database mode
USE_SQLITE=0
USE_POSTGRES_FOR_TESTS=0

# Primary PostgreSQL
POSTGRES_DB=micro_banking
POSTGRES_USER=micro_banking
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# PgBouncer
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=100
PGBOUNCER_RESERVE_POOL_SIZE=25
PGBOUNCER_SERVER_IDLE_TIMEOUT=30
PGBOUNCER_QUERY_WAIT_TIMEOUT=120
PGBOUNCER_AUTH_TYPE=plain
PGBOUNCER_ADMIN_USERS=micro_banking
PGBOUNCER_STATS_USERS=micro_banking
PGBOUNCER_IGNORE_STARTUP_PARAMETERS=extra_float_digits
PGBOUNCER_SERVER_TLS_SSLMODE=disable

# Read replica PostgreSQL
READ_REPLICA_ENABLED=0
POSTGRES_REPLICA_HOST=
POSTGRES_REPLICA_PORT=5432
POSTGRES_REPLICA_DB=micro_banking
POSTGRES_REPLICA_USER=micro_banking
POSTGRES_REPLICA_PASSWORD=replace-with-a-strong-password
POSTGRES_REPLICA_CONN_MAX_AGE=60
POSTGRES_REPLICA_CONN_HEALTH_CHECKS=1
POSTGRES_REPLICA_DISABLE_SERVER_SIDE_CURSORS=0
POSTGRES_REPLICA_SSL_MODE=
POSTGRES_REPLICA_APPLICATION_NAME=micro-banking-api-replica

# Celery and Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REALTIME_REDIS_URL=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# Connection and cache tuning
DB_USE_PGBOUNCER=1
CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=0
DB_DISABLE_SERVER_SIDE_CURSORS=1
POSTGRES_SSL_MODE=
POSTGRES_APPLICATION_NAME=micro-banking-api
LIST_CACHE_TIMEOUT_SECONDS=60
ACCOUNT_BALANCE_CACHE_TIMEOUT_SECONDS=60
EXCHANGE_RATE_CACHE_TIMEOUT_SECONDS=300
TRANSACTION_STUCK_THRESHOLD_SECONDS=300

# Background jobs and FX
TRANSACTION_OUTBOX_PUBLISH_INTERVAL_SECONDS=15
TRANSACTION_OUTBOX_PUBLISH_BATCH_SIZE=100
TRANSACTION_RECOVERY_INTERVAL_SECONDS=60
TRANSACTION_PARTITION_MAINTENANCE_INTERVAL_SECONDS=86400
TRANSACTION_PARTITION_MONTHS_AHEAD=3
EXCHANGE_RATE_SYNC_INTERVAL_SECONDS=900
FX_EXCHANGE_FEE_RATE=0.01

# Security flags
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1

# Bootstrap admin user
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeMe123!
