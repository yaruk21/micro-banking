# Django core
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-characters
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Kyiv

# Local/test database mode
USE_SQLITE=0
USE_POSTGRES_FOR_TESTS=0

# Primary PostgreSQL
POSTGRES_DB=micro_banking
POSTGRES_USER=micro_banking
POSTGRES_PASSWORD=micro_banking
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Read replica PostgreSQL
READ_REPLICA_ENABLED=0
POSTGRES_REPLICA_HOST=
POSTGRES_REPLICA_PORT=5432
POSTGRES_REPLICA_DB=micro_banking
POSTGRES_REPLICA_USER=micro_banking
POSTGRES_REPLICA_PASSWORD=micro_banking
POSTGRES_REPLICA_CONN_MAX_AGE=60
POSTGRES_REPLICA_CONN_HEALTH_CHECKS=1
POSTGRES_REPLICA_DISABLE_SERVER_SIDE_CURSORS=0
POSTGRES_REPLICA_SSL_MODE=
POSTGRES_REPLICA_APPLICATION_NAME=micro-banking-api-replica

# Celery and Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REALTIME_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# Connection and cache tuning
DB_USE_PGBOUNCER=0
CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=1
DB_DISABLE_SERVER_SIDE_CURSORS=0
POSTGRES_SSL_MODE=
POSTGRES_APPLICATION_NAME=micro-banking-api
LIST_CACHE_TIMEOUT_SECONDS=60
ACCOUNT_BALANCE_CACHE_TIMEOUT_SECONDS=60
EXCHANGE_RATE_CACHE_TIMEOUT_SECONDS=300
TRANSACTION_STUCK_THRESHOLD_SECONDS=300

# Background jobs and FX
TRANSACTION_OUTBOX_PUBLISH_INTERVAL_SECONDS=15
TRANSACTION_OUTBOX_PUBLISH_BATCH_SIZE=100
TRANSACTION_RECOVERY_INTERVAL_SECONDS=60
TRANSACTION_PARTITION_MAINTENANCE_INTERVAL_SECONDS=86400
TRANSACTION_PARTITION_MONTHS_AHEAD=3
EXCHANGE_RATE_SYNC_INTERVAL_SECONDS=900
FX_EXCHANGE_FEE_RATE=0.01

# Security flags
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
